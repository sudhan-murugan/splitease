# App
PORT=3000
NODE_ENV=development

# PostgreSQL
# Either set DATABASE_URL (takes precedence, e.g. on Render)...
# DATABASE_URL=postgres://user:password@host:5432/splitease
# ...or the individual settings below
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=splitease
# Set to true for cloud providers that require TLS (e.g. Neon)
DB_SSL=false
# Auto-create/update tables from entities. Dev only; always off when NODE_ENV=production.
DB_SYNCHRONIZE=true
# Run pending migrations on startup (defaults to true when NODE_ENV=production)
# DB_MIGRATIONS_RUN=false

# JWT auth
# Long random secret, e.g. generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Access token lifetime (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h
